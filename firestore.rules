rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      // apni email yahan likhein
      return request.auth != null && request.auth.token.email == "YOUR_EMAIL@gmail.com";
    }
    match /products/{id} { allow read: if true; allow write: if isOwner(); }
    match /settings/{id} { allow read: if true; allow write: if isOwner(); }
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n','m','s','t'])
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 40
        && request.resource.data.m is string && request.resource.data.m.size() > 0 && request.resource.data.m.size() <= 300
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5
        && request.resource.data.t is number;
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
